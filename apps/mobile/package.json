{
  "name": "god-bookings-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --no-bundler",
    "test": "node -e \"console.log('Mobile UI test harness scaffolded; add Detox/RTL suites next.')\"",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios",
    "ios:preflight": "powershell -ExecutionPolicy Bypass -File ../../scripts/ios/mobileIosPreflight.ps1",
    "eas:whoami": "npx eas-cli whoami",
    "eas:project:init": "npx eas-cli project:init",
    "build:preview": "npx eas-cli build --platform android --profile preview",
    "build:preview:local": "npx eas-cli build --platform android --profile preview --local",
    "build:production": "npx eas-cli build --platform android --profile production",
    "build:ios:testflight": "npx eas-cli build --platform ios --profile testflight",
    "build:ios:production": "npx eas-cli build --platform ios --profile production-ios",
    "submit:ios:testflight": "npx eas-cli submit --platform ios --profile testflight"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "~52.0.37",
    "expo-asset": "~11.0.5",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.5",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-calendars": "^1.1307.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-google-places-autocomplete": "^2.5.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.7.2"
  }
}
