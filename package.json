{
  "name": "atlanta-namadwaar-home-program-booking",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generateProgramImageManifest.mjs",
    "web:dev": "vite",
    "dev": "vite",
    "start": "vite preview --host 0.0.0.0 --port 8080",
    "prebuild": "node scripts/generateProgramImageManifest.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "web:build": "vite build",
    "build": "vite build",
    "postbuild": "node scripts/postBuildCleanup.mjs",
    "web:preview": "vite preview",
    "preview": "vite preview",
    "deploy:ftps": "npm run build && node scripts/deployFtps.mjs",
    "deploy:ftps:only": "node scripts/deployFtps.mjs",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:android": "powershell -ExecutionPolicy Bypass -File scripts/mobileAndroid.ps1",
    "mobile:ios": "powershell -ExecutionPolicy Bypass -File scripts/ios/mobileIosDev.ps1",
    "mobile:ios:preflight": "powershell -ExecutionPolicy Bypass -File scripts/ios/mobileIosPreflight.ps1",
    "mobile:test": "npm --prefix apps/mobile run test",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:eas:whoami": "npm --prefix apps/mobile run eas:whoami",
    "mobile:eas:project:init": "npm --prefix apps/mobile run eas:project:init",
    "mobile:build:preview": "npm --prefix apps/mobile run build:preview",
    "mobile:build:preview:local": "npm --prefix apps/mobile run build:preview:local",
    "mobile:build:production": "npm --prefix apps/mobile run build:production",
    "mobile:build:ios:testflight": "powershell -ExecutionPolicy Bypass -File scripts/ios/mobileIosBuild.ps1 -Profile testflight",
    "mobile:build:ios:production": "powershell -ExecutionPolicy Bypass -File scripts/ios/mobileIosBuild.ps1 -Profile production-ios",
    "mobile:submit:ios:testflight": "powershell -ExecutionPolicy Bypass -File scripts/ios/mobileIosSubmit.ps1 -Profile testflight"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "dotenv": "^16.6.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
