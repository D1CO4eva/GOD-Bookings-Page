{
  "name": "atlanta-namadwaar-home-program-booking",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generateProgramImageManifest.mjs",
    "dev": "vite",
    "start": "vite preview --host 0.0.0.0 --port 8080",
    "prebuild": "node scripts/generateProgramImageManifest.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "build": "vite build",
    "postbuild": "node scripts/postBuildCleanup.mjs",
    "preview": "vite preview",
    "deploy:ftps": "npm run build && node scripts/deployFtps.mjs",
    "deploy:ftps:only": "node scripts/deployFtps.mjs"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "dotenv": "^16.6.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
